{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash ~/.claude/hooks/agent-starter-kit/guard.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash ~/.claude/hooks/agent-starter-kit/guard.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read", "hooks": [ { "type": "command", "command": "bash ~/.claude/hooks/agent-starter-kit/guard.sh" } ] }
    ]
  }
}
